# Application
APP_NAME=Solana Wallet Radar
APP_DEMO_MODE=true
DATABASE_URL=sqlite:///./data/radar.db
APP_BASE_URL=http://localhost:8000

# Set APP_DEMO_MODE=false and populate these for live on-chain research.
# Never expose these values in browser code or commit a real .env file.
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# Optional Telegram alerting. Create a bot with BotFather; use a private chat or group ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SCORE_THRESHOLD=80

# 0 disables scheduled re-scans. Set e.g. 15 after validating API quotas/costs.
AUTO_SCAN_INTERVAL_MINUTES=0
SCAN_LOOKBACK_DAYS=30
MIN_CONSENSUS_WALLETS=3
MIN_LIQUIDITY_USD=25000
